{
  "name": "aleph-edge",
  "version": "0.3.19",
  "description": "Aleph Edge — Sentinel Aleph automated trading bot (Tauri desktop)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-no-dev-mocks.cjs",
    "build:check": "node scripts/check-no-dev-mocks.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-locale-parity.cjs",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@types/qrcode": "^1.5.6",
    "framer-motion": "^14.3.1",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
